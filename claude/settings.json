{
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\chberger\\.claude\\hooks\\herdr-agent-state.ps1\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "askUserQuestionTimeout": "never",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "vim",
  "maxProseWidth": 120,
  "env": {
    "EDITOR": "nvim"
  }
}
